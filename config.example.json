{
  "input_directory": "input",
  "output_directory": "",
  "temp_directory": "temp",
  "backup_originals": true,
  "backup_suffix": ".bak",
  "preserve_metadata": false,
  "video_bit_depth": 10,
  "quality_rf_by_resolution": {
    "2160": 22.5,
    "1080": 22.5,
    "720": 23.0,
    "480": 23.0
  },
  "encoder_preset": "fast",
  "crop_mode": "auto",
  "denoise_mode": "off",
  "hdr_denoise_mode": "off",
  "always_reencode": false,
  "minimum_projected_savings_percent": 10.0,
  "sample_count": 3,
  "sample_duration_seconds": 10.0,
  "reanalysis_mode": "progressive",
  "progressive_sample_max": 6,
  "audio_fallback_codec": "aac",
  "audio_passthrough_codecs": [
    "aac",
    "ac3",
    "eac3",
    "truehd",
    "dts",
    "dtshd"
  ],
  "audio_stream_mode": "first_english",
  "audio_bitrate_per_channel": 64000,
  "minimum_audio_bitrate": 128000,
  "duration_tolerance_seconds": 2.0,
  "encoding_backend": "handbrake",
  "handbrake_cli": "HandBrakeCLI",
  "ffprobe": "ffprobe",
  "watch_input_directory": true,
  "select_new_files_for_encoding": true,
  "inspect_new_files": true,
  "clean_new_encodes": true,
  "mark_filenames_with_spaces": true,
  "mark_filenames_missing_year_or_episode": true,
  "file_ready_seconds": 10.0,
  "rescan_interval_seconds": 5.0,
  "theme": "dark"
}
